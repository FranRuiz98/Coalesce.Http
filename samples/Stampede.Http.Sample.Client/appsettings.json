{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Sample": {
    "Instance": "local",
    "ApiBaseUrl": "http://localhost:5080",
    "RedisConnection": "localhost:6379",

    "Pipeline": {
      "Enabled": true,
      "UseRedis": true,
      "DefaultTtl": "00:00:05",
      "CoalescingTimeout": "00:00:10",
      "CoalesceKeyHeaders": [ "X-Tenant-Id" ],
      "NormalizeQueryParameters": true,
      "MaxResponseBodyBytes": 4194304
    },

    "Workload": {
      "Enabled": true,
      "StampedeSize": 10,
      "FeatureTour": true,
      "Interval": "00:00:02",
      "MutateEvery": 10
    }
  }
}
